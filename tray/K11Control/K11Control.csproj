<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>1.0.2</Version>
    <Product>FiiO K11 R2R Control</Product>
    <Description>System tray control app for FiiO K11 R2R DAC/Amp (FW M79)</Description>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>K11Control</AssemblyName>
    <RootNamespace>K11Control</RootNamespace>
    <ApplicationIcon>Assets\K11Control.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\K11Control.ico" />
  </ItemGroup>
</Project>
